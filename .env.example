DATABASE_URL="postgresql://USER@localhost:5432/seqresign?schema=public"
DATABASE_URL_UNPOOLED="postgresql://USER@localhost:5432/seqresign?schema=public"
APP_URL="http://localhost:3000"

# openssl rand -hex 32
JWT_SECRET=""
# openssl rand -hex 32  (AES-256-GCM key for stored files)
STORAGE_KEY=""
STORAGE_DIR="./storage"

ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# authkey | console
SMS_MODE="console"
AUTHKEY_API_KEY=""
AUTHKEY_OTP_SID=""
# Your Authkey template's variable names → values. Placeholders: {otp} {site} {minutes} (and {name} {link} for links).
# Check the exact {#names#} in Authkey → Templates. Example for "{#otp#} is your OTP for {#site#}": otp={otp}&site={site}
AUTHKEY_OTP_VARS="otp={otp}"
AUTHKEY_LINK_VARS="name={name}&link={link}"
OTP_TTL_MINUTES="10"
AUTHKEY_LINK_SID=""
SMS_COUNTRY_CODE="91"

# WhatsApp intimation via Gupshup (approved template). Params are "|"-separated:
# {exam} {name} {centre} {link} {token}. For "...CSR Form for {{1}}." use "{exam}".
GUPSHUP_API_KEY=""
GUPSHUP_APP_NAME=""
GUPSHUP_SOURCE=""
GUPSHUP_TEMPLATE_ID=""
GUPSHUP_TEMPLATE_PARAMS="{exam}"

# Secret for /api/webhooks/gupshup (header x-webhook-key or ?key=)
GUPSHUP_WEBHOOK_KEY=""
