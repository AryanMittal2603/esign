{
  "name": "seqresign",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "node scripts/copy-assets.mjs && prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "dev:lan": "next dev -H 0.0.0.0 --experimental-https",
    "setup": "npm install && npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "exceljs": "^4.4.0",
    "jose": "^6.2.12",
    "jszip": "^3.10.2",
    "next": "15.5.27",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
