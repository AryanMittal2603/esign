generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection for migrations. Neon on Vercel provides DATABASE_URL_UNPOOLED.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
}

model Project {
  id          String       @id @default(cuid())
  name        String
  examName    String?
  examDate    String?
  shift       String?
  description String?
  createdAt   DateTime     @default(now())
  signatories Signatory[]
  auditLogs   AuditLog[]
}

enum SignatoryStatus {
  IMPORTED
  SENT
  OPENED
  VERIFIED
  UPLOADED
  SIGNED
}

model Signatory {
  id         String          @id @default(cuid())
  projectId  String
  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String
  mobile     String
  centreCode String
  centreName String
  token      String          @unique
  status     SignatoryStatus @default(IMPORTED)

  linkSentAt DateTime?
  linkSentVia String?
  openedAt   DateTime?
  verifiedAt DateTime?

  // draft (before signing; replaceable)
  draftKey   String?
  draftPages Int?
  draftSize  Int?
  draftHash  String?
  uploadedAt DateTime?

  // live photo
  photoKey     String?
  photoAt      DateTime?
  faceCheck    String? // "passed" | "unavailable"
  liveness     String? // "passed" (blink + head turn) | "unavailable"
  geoLat       Float?
  geoLng       Float?
  geoAccuracy  Float?

  consentAt  DateTime?

  // signature (immutable once set)
  signedAt     DateTime?
  signedKey    String?
  signedHash   String?
  documentId   String?   @unique
  otpRef       String?
  otpSentAt    DateTime?
  otpVerifiedAt DateTime?
  signIp       String?
  signUserAgent String?

  // latest invitation message (WhatsApp/SMS) delivery state, for fast filtering and counts
  msgChannel  String?
  msgStatus   String?   // submitted | enqueued | sent | delivered | read | failed
  msgStatusAt DateTime?
  msgError    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  auditLogs AuditLog[]
  messages  Message[]

  @@index([projectId, msgStatus])
  @@unique([projectId, mobile])
  @@unique([projectId, centreCode])
  @@index([mobile])
}

enum OtpPurpose {
  ACCESS
  SIGN
}

model Otp {
  id          String     @id @default(cuid())
  mobile      String
  purpose     OtpPurpose
  signatoryId String?
  codeHash    String
  ref         String
  attempts    Int        @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())

  @@index([mobile, purpose])
}

model AuditLog {
  id          String     @id @default(cuid())
  projectId   String?
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  signatoryId String?
  signatory   Signatory? @relation(fields: [signatoryId], references: [id], onDelete: Cascade)
  actor       String // ADMIN | SIGNATORY | SYSTEM
  action      String
  details     Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime   @default(now())

  @@index([projectId, createdAt])
  @@index([signatoryId, createdAt])
}

/** Every invitation sent to a signatory, with provider delivery receipts. */
model Message {
  id          String    @id @default(cuid())
  projectId   String
  signatoryId String
  signatory   Signatory @relation(fields: [signatoryId], references: [id], onDelete: Cascade)
  channel     String    // WHATSAPP | SMS
  providerId  String?   @unique // Gupshup message id (returned when sending)
  waId        String?   @unique // WhatsApp message id (from the enqueued event)
  status      String    // submitted | enqueued | sent | delivered | read | failed
  error       String?
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  failedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId, status])
  @@index([signatoryId, createdAt])
}
